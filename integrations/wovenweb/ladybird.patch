diff --git a/Tests/LibHTTP/TestProxy.cpp b/Tests/LibHTTP/TestProxy.cpp
index b4d5db83..78a3c961 100644
--- a/Tests/LibHTTP/TestProxy.cpp
+++ b/Tests/LibHTTP/TestProxy.cpp
@@ -105,3 +105,24 @@ TEST_CASE(no_proxy_matching)
     configuration = configuration_from({ { "all_proxy"sv, "http://proxy"sv }, { "NO_PROXY"sv, "*"sv } });
     EXPECT(!is_proxied("https://example.com/"sv));
 }
+
+TEST_CASE(wovenweb_tor_mode_ignores_overrides_and_bypasses)
+{
+    auto configuration = configuration_from({
+        { "WOVENWEB_TOR_ONLY"sv, "1"sv },
+        { "http_proxy"sv, "http://attacker.invalid:8080"sv },
+        { "https_proxy"sv, "http://attacker.invalid:8080"sv },
+        { "NO_PROXY"sv, "*"sv },
+    });
+    for (auto target : { "http://example.com"sv, "https://example.com"sv, "ws://example.com"sv, "wss://example.com"sv, "http://example.onion"sv, "http://127.0.0.1"sv }) {
+        auto proxy = configuration.proxy_for(url(target));
+        EXPECT(proxy.has_value());
+        if (!proxy.has_value())
+            continue;
+        EXPECT_EQ(proxy->type, HTTP::Proxy::Type::SOCKS5Hostname);
+        EXPECT_EQ(proxy->host, "127.0.0.1"sv);
+        EXPECT_EQ(proxy->port, 9050);
+        EXPECT(proxy->resolves_hostnames());
+    }
+    EXPECT(configuration.no_proxy().is_empty());
+}
